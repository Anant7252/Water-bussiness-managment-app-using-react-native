{
  "expo": {
    "name": "AquaTrack",
    "slug": "AquaTrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/icon.png",
        "backgroundColor": "#C6CFFD"
      },
      "package": "com.anant7252.newwaterbussinessapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icons/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/appsplash.jpg",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff",
          "enableFullScreenImage_legacy": true
        }
      ],
      [
        "expo-background-fetch",
        {
          "backgroundFetchInterval": 60000
        }
      ],
      [
        "expo-ads-admob",
        {
          "userTrackingPermission": "This identifier will be used to deliver personalized ads to you.",
          "androidAdMobAppId": "ca-app-pub-5488722195467401~8596780514"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
